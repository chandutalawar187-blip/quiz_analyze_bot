DISCORD_BOT_TOKEN=your-discord-bot-token
# Optional: blank detects bot/webhook quiz-start and leaderboard signals automatically.
QUIZCORD_BOT_ID=
# Optional migration target for data from an earlier single-server database.
BOT_GUILD_ID=
BOT_DATABASE_PATH=server_results.db

# Optional web dashboard. Configure all four values to enable it.
DASHBOARD_PUBLIC_URL=https://analytics.example.com
DISCORD_OAUTH_CLIENT_ID=your-discord-application-client-id
DISCORD_OAUTH_CLIENT_SECRET=your-discord-application-client-secret
DASHBOARD_SESSION_SECRET=replace-with-at-least-32-random-characters
# Optional legacy default faculty role ID. Configure roles per server in the
# dashboard after setup.
FACULTY_ROLE_ID=
# Cloudflare Turnstile keys; both are required together.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Keep the app bound to localhost behind an HTTPS reverse proxy.
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8765

# Optional Sentry error and performance monitoring. The same public DSN enables
# optional browser analytics on the admin quiz-session dashboard only, after
# the administrator accepts it in Cookie settings.
# Leave SENTRY_DSN blank to disable telemetry. Configure SENTRY_ENVIRONMENT
# separately in production (for example, "production").
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_PROFILE_SAMPLE_RATE=0.01
SENTRY_ENVIRONMENT=development
