DISCORD_BOT_TOKEN=your-discord-bot-token
# Optional: blank detects bot/webhook quiz-start and leaderboard signals automatically.
QUIZCORD_BOT_ID=
BOT_GUILD_ID=your-server-id
BOT_DATABASE_PATH=server_results.db

# Optional web dashboard. Configure all four values to enable it.
DASHBOARD_PUBLIC_URL=https://analytics.example.com
DISCORD_OAUTH_CLIENT_ID=your-discord-application-client-id
DISCORD_OAUTH_CLIENT_SECRET=your-discord-application-client-secret
DASHBOARD_SESSION_SECRET=replace-with-at-least-32-random-characters
# Optional: Discord server role ID required for the faculty dashboard.
FACULTY_ROLE_ID=
# Keep the app bound to localhost behind an HTTPS reverse proxy.
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8765
